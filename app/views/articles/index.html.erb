<h1>Articles listing page</h1>

<%= link_to 'Create', new_article_path, type:"button", class:"btn btn-success mb-2" %>

<table class="table table table-striped table-bordered">
  <thead>
  <tr>
    <th scope="col">Title</th>
    <th scope="col">Description</th>
    <th scope="col">Actions</th>
  </tr>
  </thead>

  <tbody>
  <% @articles.each do |article| %>
    <tr>
      <td><%= article.title %></td>
      <td><%= article.description %></td>
      <td class="d-flex gap-2">
        <%= link_to 'Show', article_path(article), type:"button", class:"btn btn-primary" %>
        <%= link_to 'Edit', edit_article_path(article), type:"button", class:"btn btn-warning" %>
        <%= button_to 'Delete', article_path(article), method: :delete, type:"button", class:"btn btn-danger" %>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>