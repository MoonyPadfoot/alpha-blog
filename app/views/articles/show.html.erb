<h1>Show article details</h1>

<h2>Title: <%= @article.id %></h2>

<p>Description: <%= @article.description %></p>

<%= link_to 'Return to Article Listings', articles_path, type: 'button', class: 'btn btn-primary' %>

<%= link_to 'Edit', edit_article_path(@article), type: "button", class: "btn btn-warning" %>

<%= button_to 'Delete', article_path(@article), method: :delete, type: "button", class: "btn btn-danger",
              form: { style: 'display:inline-block;', data: { turbo_confirm: 'Are you sure?' } } %>